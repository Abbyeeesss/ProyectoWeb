# Copie este archivo como .env y pegue su cadena de Supabase.
# Supabase → Project Settings → Database → Connection string → URI
# Use la conexión "Direct" (puerto 5432) o Session pooler según la doc del proyecto.
#
# Ejemplo (la contraseña la define usted al crear el proyecto):
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=
